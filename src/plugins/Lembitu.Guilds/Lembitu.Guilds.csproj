<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PluginGuid>lembitu.guilds</PluginGuid>
    <Version>0.2.0</Version>
    <Description>Guilds form in game and claim SeparateSpawns' start regions (ADR-0028): guildless players hold the sacrificial stones, a guild leader claims one of the three regions at its portal stone after a confirmation window, and the region follows guild membership.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!-- Compiled against the pinned packages scripts/stage-stack.sh puts in dist/plugins/, so the
       hooks are checked against exactly what we deploy. SeparateSpawns and Guilds are publicized:
       the bridge reaches their internal roster, resolver and server guild store directly, and each
       feature re-verifies what it touches at startup. -->
  <ItemGroup>
    <Reference Include="SeparateSpawns" Private="false" StagedMod="SeparateSpawns">
      <HintPath>$(PluginDistDir)SeparateSpawns/SeparateSpawns.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="Guilds" Private="false" StagedMod="Guilds">
      <HintPath>$(PluginDistDir)Guilds/Guilds.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="Jotunn" Private="false" StagedMod="Jotunn">
      <HintPath>$(PluginDistDir)Jotunn/Jotunn.dll</HintPath>
    </Reference>
    <!-- The claim window is Jotunn GUIManager panels; Jotunn's button text may be TMP. -->
    <Reference Include="Unity.TextMeshPro" Private="false">
      <HintPath>$(ValheimRefDir)Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule" Private="false">
      <HintPath>$(ValheimRefDir)UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI" Private="false">
      <HintPath>$(ValheimRefDir)UnityEngine.UI.dll</HintPath>
    </Reference>
    <!-- Claim store: the claim file is read and written on the server; the runtime copy ships with
         the game, so only the compile-time reference is needed. -->
    <PackageReference Include="Newtonsoft.Json" Version="[13.0.4]" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
