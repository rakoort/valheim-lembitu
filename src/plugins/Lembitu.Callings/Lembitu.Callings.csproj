<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PluginGuid>lembitu.callings</PluginGuid>
    <Version>0.5.0</Version>
    <Description>Callings (ADR-0021, ADR-0022): four focus professions chosen in the Calling window at the Oathstone, the steep curve for every other profession, shadow levels, focus protection on death, and the Herbalist and Fishing bonus output. Also follows soil's rules for SeedBed's beds, refuses Herbalist tonics whose biome's boss key the drinker lacks, keeps Herbalist's mead scaling to once per drink, and locks BlacksmithingExpanded's settings. The cook (ADR-0029): the cook's grade on dishes, through cooking stations and into FineDining's food stats and shelf life, eaten food's scale kept through a relog, and work meals. The balance policy (ADR-0030): log splitter, quick bite and steady overload milestones, and an hourly profession XP log on the server.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!-- Compiled against the pinned packages scripts/stage-stack.sh puts in dist/plugins/. World
       Advancement Progression is publicized because its skill floor, drain and gain rules are
       protected members; the death drain and the shadow level reuse them rather than copy them.
       SeedBed is referenced because the bed rule hooks Germination.UseItem and AddItem; FineDining
       is publicized because the cook's grade scales its internal food effect and spoilage rule;
       Herbalist, the smith and ImpactfulSkills are reached by reflection and ObjectDB recipes alone. -->
  <ItemGroup>
    <Reference Include="VentureValheim.Progression" Private="false" StagedMod="World_Advancement_Progression">
      <HintPath>$(PluginDistDir)World_Advancement_Progression/Plugins/VentureValheim.Progression.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="SeedBed" Private="false" StagedMod="SeedBed">
      <HintPath>$(PluginDistDir)SeedBed/SeedBed.dll</HintPath>
    </Reference>
    <Reference Include="FineDining" Private="false" StagedMod="FineDining">
      <HintPath>$(PluginDistDir)FineDining/FineDining.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="Jotunn" Private="false" StagedMod="Jotunn">
      <HintPath>$(PluginDistDir)Jotunn/Jotunn.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro" Private="false">
      <HintPath>$(ValheimRefDir)Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI" Private="false">
      <HintPath>$(ValheimRefDir)UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule" Private="false">
      <HintPath>$(ValheimRefDir)UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
