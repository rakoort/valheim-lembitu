<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PluginGuid>lembitu.oathbound</PluginGuid>
    <Version>0.4.0</Version>
    <Description>Adapts Oathbound: oath changes and free respec at the Oathstone, a portable talent tree, party kill XP, poison credit, gathering tools for every class, boss-key-capped power, and server-locked spell growth, companion damage and BetterArchery gameplay.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!-- Compiled against the pinned packages scripts/stage-stack.sh puts in dist/plugins/, so the
       hooks are checked against exactly what we deploy. Oathbound and SocialSystem are publicized:
       every hook reaches private members, and each one is re-verified at startup. -->
  <ItemGroup>
    <Reference Include="WarriorRpg" Private="false" StagedMod="Oathbound">
      <HintPath>$(PluginDistDir)Oathbound/WarriorRpg/WarriorRpg.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="Warrior.Core" Private="false" StagedMod="Oathbound">
      <HintPath>$(PluginDistDir)Oathbound/WarriorRpg/Warrior.Core.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="SocialSystem" Private="false" StagedMod="SocialSystem">
      <HintPath>$(PluginDistDir)SocialSystem/SocialSystem.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="VentureValheim.Progression" Private="false" StagedMod="World_Advancement_Progression">
      <HintPath>$(PluginDistDir)World_Advancement_Progression/Plugins/VentureValheim.Progression.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="Jotunn" Private="false" StagedMod="Jotunn">
      <HintPath>$(PluginDistDir)Jotunn/Jotunn.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro" Private="false">
      <HintPath>$(ValheimRefDir)Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI" Private="false">
      <HintPath>$(ValheimRefDir)UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule" Private="false">
      <HintPath>$(ValheimRefDir)UnityEngine.AssetBundleModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
