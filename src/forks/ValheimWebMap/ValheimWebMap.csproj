<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PluginGuid>com.valheimwebmap</PluginGuid>
    <PluginDisplayName>Valheim Web Map</PluginDisplayName>
    <Version>1.3.0</Version>
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="[13.0.4]" ExcludeAssets="runtime" PrivateAssets="all" />
    <EmbeddedResource Include="web/**/*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
