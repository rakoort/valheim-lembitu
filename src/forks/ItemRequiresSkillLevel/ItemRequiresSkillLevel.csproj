<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Upstream's GUID, unchanged: the rule files are globbed as
         BepInEx/config/WackyMole.ItemRequiresSkillLevel*.yml and the ServerSync channel derives
         from it. -->
    <PluginGuid>WackyMole.ItemRequiresSkillLevel</PluginGuid>
    <PluginDisplayName>ItemRequiresSkillLevel</PluginDisplayName>
    <Version>1.4.6</Version>
    <!-- Upstream predates nullable reference types but annotates a few members, and the
         ServerSync source compiled in here is fully annotated. "annotations" accepts both without
         warning on either; "disable" would report every `?` in ServerSync as CS8632. -->
    <Nullable>annotations</Nullable>
    <Description>Blocks crafting, equipping and consuming items until a character meets a configured level, attribute or key requirement, and says so in the tooltip.</Description>
  </PropertyGroup>

  <Import Project="$(RepoRoot)src/forks/ServerSync/ServerSync.props" />

  <ItemGroup>
    <!-- Compile against exactly the YamlDotNet the server loads, but ship nothing: BepInEx
         resolves it from the plugins directory, where the pinned ValheimModding/YamlDotNet 16.3.1
         package puts one copy. That package's payload is YamlDotNet 16.3.0 (assembly version
         16.0.0.0, file version 16.3.0.0) and 16.3.1 was never released on NuGet, so the version
         here is exact and deliberately not 16.3.1: a floating reference resolves to 17.x, whose
         assembly version does not match what the server has loaded. -->
    <PackageReference Include="YamlDotNet" Version="[16.3.0]" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The craft button and the recipe description panel. -->
    <Reference Include="UnityEngine.UIModule" Private="false">
      <HintPath>$(ValheimRefDir)UnityEngine.UIModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
