<!-- Import this from a plugin's .csproj to compile ServerSync into it:

       <Import Project="$(RepoRoot)src/forks/ServerSync/ServerSync.props" />

     ServerSync is shared source, not a shared DLL. Upstream distributes it that way (its README
     tells you to ILRepack it in), and its Harmony patches are written for it: PatchServerSync only
     de-duplicates patches within its own assembly, so one copy per mod is the supported shape.
     Vendoring the source once and compiling it into every consumer keeps a single copy to fix,
     without asking BepInEx to resolve a shared library at load time. -->
<Project>

  <PropertyGroup>
    <ServerSyncDir>$(MSBuildThisFileDirectory)</ServerSyncDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ServerSyncDir)ConfigSync.cs" Link="ServerSync/ConfigSync.cs" />
  </ItemGroup>

  <!-- References beyond the baseline in Directory.Build.props that ServerSync itself needs. -->
  <ItemGroup>
    <!-- TextMeshPro and UI: the connection-error panel ServerSync writes version errors into. -->
    <Reference Include="Unity.TextMeshPro" Private="false">
      <HintPath>$(ValheimRefDir)Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI" Private="false">
      <HintPath>$(ValheimRefDir)UnityEngine.UI.dll</HintPath>
    </Reference>
    <!-- DeflateStream, for config packages over 10 kB. -->
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

</Project>
