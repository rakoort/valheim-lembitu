# Launch configuration for the Run (#19). Non-secret values only: this file is committed.
#
# Everything here is passed to the valheim-server container as `-e VAR=value`. The secret file
# beside it (launch.secret.env, gitignored) carries the password and, later, the Discord webhook.
#
#   config/launch/launch.env.example   this file - committed, non-secret, reviewable in a diff
#   config/launch/launch.secret.env    SERVER_PASS - never committed
#   scripts/launch-server.sh env       prints the container environment, secret file merged in
#   scripts/launch-server.sh run       starts the container from this configuration
#
# Values marked "Chosen" are launch decisions recorded in docs/wiki/operations.md. Values marked
# "Derived" follow from the pack or from ADR-0007 and are not free choices.

# --- Chosen: server identity and the world -------------------------------------
# The name players see. An unlisted server (SERVER_PUBLIC=false) is joined by address.
SERVER_NAME=Lembitu
# The world the Run is played on. It names both the save path and the world, so it is fixed at
# launch-world creation; renaming it afterwards starts a different world (ADR-0007, ADR-0009).
WORLD_NAME=Lembitu
SERVER_PORT=2456
# Unlisted: not published to the public server browser. The Roster joins by address.
SERVER_PUBLIC=false
# Steam backend, not crossplay: the Roster is all Steam and crossplay routes through PlayFab.
CROSSPLAY=false
TZ=Europe/Oslo

# --- Chosen: world rules (the launch modifier set) -----------------------------
# Verified against Valheim 1.0.12 on 2026-09-15 by booting a disposable server and reading the
# game's own parse lines from the Unity log:
#
#   Setting world modifier preset: hard
#   Setting world modifier: Portals->hard
#
# The dedicated server takes one `-preset` and repeated `-modifier <Name> <value>` arguments, and
# there is no per-modifier environment variable in the container, so the whole arg string lives
# here where it is reviewable.
#
# `-preset hard` sets the whole modifier set first, so it is the baseline; the `-modifier` line
# after it overrides the one setting the preset does not already say. Order matters and is the
# reverse of the manual's advice for a reason: the preset is a starting point here, not the last
# word. (The manual says to put modifiers after a preset for the same reason.)
#
# Valid values are an exact, closed set. Two mistakes are worth naming because they fail *quietly*:
#
#   - `-modifier DeathPenalty normal` is REJECTED. Measured: "Could not parse 'DeathPenalty' with a
#     value of 'normal' as a world modifier." The server logs the refusal and boots anyway, so a
#     typo here silently leaves the rule unset. There is no `normal` value for DeathPenalty,
#     Resources or Raids - the vanilla behaviour is what you get by NOT passing the modifier.
#   - `Preset` overwrites every modifier set before it, so a modifier written above `-preset` is
#     lost without any log line.
#
# The launch set, and what each choice is:
#
#   Combat        hard    from `-preset hard`. The #13 difficulty tier. CreatureManager's
#                         `Biome Level Preset = Hard` is the same decision applied through the mod
#                         (config/enforced/sighsorry.CreatureManager.cfg)
#   DeathPenalty  vanilla by omission. The run uses the ordinary death penalty; PvPBiomeDominions
#                         adds retention for flagged players only
#                         (config/enforced/Turbero.PvPBiomeDominions.cfg)
#   Resources     vanilla by omission = 1x. This is not a grinding server
#   Raids         vanilla by omission. World Advance Progression makes raids per-player
#                         (UsePrivateRaids, config/enforced/com.orianaventure.mod.WorldAdvancementProgression.cfg)
#   Portals       hard    the launch rule: ore and processed metal cannot pass through a portal.
#                         This is the one modifier the Hard preset does not already give us, which
#                         is why it is the only one written out
#
# The four `-setkey` checkboxes (nobuildcost, playerevents, passivemobs, nomap) are all deliberately
# absent: building stays free and the map stays vanilla. PortalRules owns the portal map
# (Enable Portal Map = Off in config/enforced/sighsorry.PortalRules.cfg). `-setkey` only ever sets a
# key, it never clears one, so the absence of these is the choice, not an oversight.
SERVER_ARGS=-savedir /config/save -preset hard -modifier Portals hard

# --- Chosen: capacity and admission --------------------------------------------
# Cap 20 above a fifteen-player Roster (ADR-0007). The MaxPlayerCount fork enforces it on the
# host's own admission path and in the capacity it advertises to Steam; the number itself lives in
# the deployed config on the host, not in this file.
#
# Admission is by permitted list: permittedlist.txt is a whitelist, and adding anyone to it bans
# everyone else, so it is the Roster. It holds one platform identity per line in the
# `[Platform]_[User ID]` form the server log and the F2 panel show. Those identities belong to real
# people, so the file lives on the host, never in this repository.
#
# SERVER_PASS is required and comes from config/launch/launch.secret.env.

# --- Derived: freeze and schedule (ADR-0007) -----------------------------------
# The Run holds one game version. Updating must not happen on a schedule, and the container's own
# updater must not restart the server onto a newer build behind us.
#
# UPDATE_CRON is a cron expression and the container does not accept a "never" keyword, so a date
# far in the future disables it: 01 January 2100. UPDATE_IF_IDLE is a second guard - the updater
# only acts with nobody connected - not the primary one.
UPDATE_CRON=0 0 1 1 * 2100
UPDATE_IF_IDLE=true
# Sunday 05:10 local. The Roster plays evenings, so a Sunday-morning restart lands between
# sessions, and RESTART_IF_IDLE means a straggler still on at 05:10 is not dropped mid-session.
RESTART_CRON=10 5 * * 0
RESTART_IF_IDLE=true

# --- Derived: backups ----------------------------------------------------------
# The container's own Backup service is OFF. Left on, it archives /config/worlds_local while the
# server writes to /config/save/worlds_local (SERVER_ARGS above), so it produces archives of a
# directory the live server never writes to: 23 byte-identical zips of a stale flat-file world were
# found on the historical host. scripts/backup-world.sh is the backup, and it captures the stores
# the server actually writes. See docs/wiki/operations.md.
BACKUPS=false

# --- Derived: mods -------------------------------------------------------------
# The server runs the pinned Pack from this repository's dist/, deployed by
# scripts/install-plugins.sh. BEPINEX=true is what makes the container provide the loader and keep
# the two plugin trees in sync.
BEPINEX=true

# --- Host ----------------------------------------------------------------------
# The user the server runs as. The container requires both bind mounts; scripts/launch-server.sh
# creates them and passes them.
PUID=1000
PGID=100
