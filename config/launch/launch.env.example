# Launch configuration for the Run (#19). Non-secret values only: this file is committed.
#
# Everything here is passed to the valheim-server container as `-e VAR=value`. The secret file
# beside it (launch.secret.env, gitignored) carries the password and, later, the Discord webhook.
#
#   config/launch/launch.env.example   this file - committed, non-secret, reviewable in a diff
#   config/launch/launch.secret.env    SERVER_PASS - never committed
#   scripts/launch-server.sh env       prints the container environment, secret file merged in
#   scripts/launch-server.sh run       starts the container from this configuration
#
# Values marked "Chosen" are launch decisions recorded in docs/wiki/operations.md. Values marked
# "Derived" follow from the pack or from ADR-0007 and are not free choices.

# --- Chosen: server identity and the world -------------------------------------
# The name players see in the server list.
SERVER_NAME=Lembitu
# The world the Run is played on. It names both the save path and the world, so it is fixed at
# launch-world creation; renaming it afterwards starts a different world (ADR-0007, ADR-0009).
WORLD_NAME=Lembitu
SERVER_PORT=2456
# Published to the public server browser, as the owner asked (2026-09-15): friends find it by name
# and join with the password. SERVER_PUBLIC=false would keep it out of the browser while remaining
# joinable by address, which is strictly more private; it is a one-line change either way.
SERVER_PUBLIC=true
# Steam backend, not crossplay: the Roster is all Steam and crossplay routes through PlayFab.
CROSSPLAY=false
TZ=Europe/Oslo

# --- Chosen: world rules (the launch modifier set) -----------------------------
# Verified against Valheim 1.0.12 on 2026-09-15 by booting a disposable server and reading the
# game's own parse lines from the Unity log:
#
#   Setting world modifier preset: hard
#   Setting world modifier: Portals->hard
#
# Every world rule is stated as its own `-modifier`. Nothing is left to be inferred from a preset.
#
# The dedicated server takes repeated `-modifier <Name> <value>` arguments, and there is no
# per-modifier environment variable in the container, so the whole arg string lives here where it is
# reviewable. Measured on Valheim 1.0.12 (2026-09-15), this exact set parses to:
#
#   Setting world modifier: Combat->hard
#   Setting world modifier: DeathPenalty->default
#   Setting world modifier: Resources->default
#   Setting world modifier: Raids->default
#   Setting world modifier: Portals->hard
#
# The values are a closed set, and a bad one fails *quietly*: the game logs
# `Could not parse '<Name>' with a value of '<value>' as a world modifier` and boots anyway, leaving
# that rule unset. `default` is the token that restores vanilla behaviour for a modifier; there is
# no `normal`. Measured rejections: `Combat normal`, `Portals normal`, `DeathPenalty normal`,
# `Resources normal`, `Raids normal`.
#
# Do not use `-preset` here. A preset assigns the whole modifier set in one go, so anything a later
# `-modifier` does not restate is silently whatever the preset chose — which for `hard` is a harsher
# death penalty and heavier raids than this Run wants. Stating all five is both what #19 specifies
# and the only version of it that can be verified from the log.
#
# The launch set, and what each choice is:
#
#   Combat        hard     the #13 difficulty tier. CreatureManager's `Biome Level Preset = Hard`
#                          is the same decision applied through the mod
#                          (config/enforced/sighsorry.CreatureManager.cfg)
#   DeathPenalty  default  the ordinary vanilla death penalty. PvPBiomeDominions adds retention for
#                          flagged players only (config/enforced/Turbero.PvPBiomeDominions.cfg)
#   Resources     default  1x. This is not a grinding server
#   Raids         default  vanilla raid frequency; World Advance Progression makes them per-player
#                          (UsePrivateRaids, config/enforced/...WorldAdvancementProgression.cfg)
#   Portals       hard     the launch rule: ore and processed metal cannot pass through a portal
#
# The four `-setkey` checkboxes (nobuildcost, playerevents, passivemobs, nomap) are all deliberately
# absent: building stays free and the map stays vanilla. PortalRules owns the portal map
# (Enable Portal Map = Off in config/enforced/sighsorry.PortalRules.cfg). `-setkey` only ever sets a
# key, it never clears one, so the absence of these is the choice, not an oversight.
SERVER_ARGS=-savedir /config/save -modifier Combat hard -modifier DeathPenalty default -modifier Resources default -modifier Raids default -modifier Portals hard

# --- Chosen: capacity and admission --------------------------------------------
# Cap 20 above a fifteen-player Roster (ADR-0007). The MaxPlayerCount fork enforces it on the
# host's own admission path and in the capacity it advertises to Steam.
#
# ADMISSION IS BY PASSWORD ALONE. There is no whitelist: `permittedlist.txt` is deliberately not
# created. Valheim treats that file as a whitelist — putting anyone in it bans everyone else — so
# leaving it absent is what keeps the server open to anyone holding the password.
#
# This is a deliberate departure from #19's "whitelisted to the invited roster" and from the Roster
# framing in ADR-0007. The owner's decision (2026-09-15) is a public, password-protected server for
# a known friend group, which is what most friend servers do. The cost is stated in
# docs/wiki/operations.md: a password is not a person filter, and this pack ships no moderation mod,
# so admission cannot be restricted beyond the password.
#
# The password is required and comes from config/launch/launch.secret.env, which is never committed.
# SERVER_PUBLIC controls only whether the server appears in the public server browser; it remains
# joinable by address either way.

# --- Derived: freeze and schedule (ADR-0007) -----------------------------------
# The Run holds one game version. Two separate mechanisms matter, and they are not the same one:
#
# 1. The cron schedule. `valheim-bootstrap` writes a crontab line only when the variable is
#    non-empty (`[ -n "$UPDATE_CRON" ]`), so an EMPTY value is the container's own disable: no line
#    is written and no SIGHUP ever reaches the updater. This is the mechanism to use.
#    Do not put a date far in the future here. The value is emitted verbatim into a busybox crontab
#    line, and busybox cron takes exactly five schedule fields — `0 0 1 1 * 2100` would schedule
#    midnight on 1 January of every year and treat `2100` as the first word of the command.
UPDATE_CRON=
# 2. The updater's own first pass. Independently of any cron, `valheim-updater`'s main loop calls
#    `update()` on its first iteration and every UPDATE_INTERVAL thereafter; `UPDATE_INTERVAL`
#    defaults to ten years, which is what makes the cron the effective trigger. The startup call
#    only proceeds when the server is idle (`is_idle`), and it re-syncs the installed game from the
#    Steam download. So a container restart while nobody is connected can still touch the game
#    files, and the real freeze is the one ADR-0007 names: the accepted versions are installed
#    once, by a controlled installation, and the host is not re-created from scratch mid-Run.
UPDATE_INTERVAL=315360000
UPDATE_IF_IDLE=true
# Sunday 05:10 local. The Roster plays evenings, so a Sunday-morning restart lands between
# sessions, and RESTART_IF_IDLE means a straggler still on at 05:10 is not dropped mid-session.
RESTART_CRON=10 5 * * 0
RESTART_IF_IDLE=true

# --- Derived: backups ----------------------------------------------------------
# The container's own Backup service is OFF. Left on, it archives /config/worlds_local while the
# server writes to /config/save/worlds_local (SERVER_ARGS above), so it produces archives of a
# directory the live server never writes to: 23 byte-identical zips of a stale flat-file world were
# found on the historical host. scripts/backup-world.sh is the backup, and it captures the stores
# the server actually writes. See docs/wiki/operations.md.
BACKUPS=false

# --- Derived: mods -------------------------------------------------------------
# The server runs the pinned Pack from this repository's dist/, deployed by
# scripts/install-plugins.sh. BEPINEX=true is what makes the container provide the loader and keep
# the two plugin trees in sync.
BEPINEX=true

# --- Host ----------------------------------------------------------------------
# The user the server runs as. The container requires both bind mounts; scripts/launch-server.sh
# creates them and passes them.
PUID=1000
PGID=100
