<Project>

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <ValheimRefDir>$(RepoRoot)lib/valheim/</ValheimRefDir>
    <BepInExRefDir>$(RepoRoot)lib/bepinex/</BepInExRefDir>
    <PluginDistDir>$(RepoRoot)dist/plugins/</PluginDistDir>
  </PropertyGroup>

  <!-- Every project in this repo is a BepInEx 5 plugin for Valheim 1.0.7. The game runs Unity's
       Mono runtime, so plugins target .NET Framework 4.7.2, and
       Microsoft.NETFramework.ReferenceAssemblies makes that target buildable off Windows. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Baseline references every plugin needs. Plugins that touch more of the game or Unity add
       their own <Reference> with a HintPath into $(ValheimRefDir), plus <Publicize>true</Publicize>
       when they need the game's private members.
       Private=false keeps game and loader assemblies out of our output; the server already has them. -->
  <ItemGroup>
    <Reference Include="assembly_valheim" Private="false">
      <HintPath>$(ValheimRefDir)assembly_valheim.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="assembly_utils" Private="false">
      <HintPath>$(ValheimRefDir)assembly_utils.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="assembly_guiutils" Private="false">
      <HintPath>$(ValheimRefDir)assembly_guiutils.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="UnityEngine" Private="false">
      <HintPath>$(ValheimRefDir)UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(ValheimRefDir)UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <!-- The loader itself, from the exact pack we deploy. -->
    <Reference Include="BepInEx" Private="false">
      <HintPath>$(BepInExRefDir)BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony" Private="false">
      <HintPath>$(BepInExRefDir)0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>


</Project>
